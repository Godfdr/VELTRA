<?xml version="1.0" encoding="utf-8"?>
<!-- 
    VELTA Android - NFC Technology Filter
    Location: res/xml/nfc_tech_filter.xml
    
    This file defines which NFC technologies the app recognizes
    for payment processing on Android devices.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ========================================== -->
    <!-- ISO/IEC 14443-A (NFC-A) Technologies      -->
    <!-- Most Common: Visa/Mastercard, Apple Pay  -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.IsoDep</tech>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- NFC Type A - Basic Support                -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- ISO/IEC 14443-B (NFC-B) Technologies      -->
    <!-- Used in some payment systems              -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.IsoDep</tech>
        <tech>android.nfc.tech.NfcB</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- NFC Type B - Basic Support                -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.NfcB</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- JIS X 6319-4 (NFC-F) Technologies         -->
    <!-- Used in Japan & Asia                      -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.NfcF</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- ISO/IEC 15693 (NFC-V) Technologies        -->
    <!-- Used in some RFID & inventory systems     -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.NfcV</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- NDEF (NFC Data Exchange Format)           -->
    <!-- Universal NFC message format              -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.Ndef</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- NDEF Formattable                          -->
    <!-- Blank NFC tags that can be formatted      -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.NdefFormatable</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- MifareClassic (Legacy Support)            -->
    <!-- Some older payment systems                -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.MifareClassic</tech>
    </tech-list>

    <!-- ========================================== -->
    <!-- MifareUltralight (Simple Tags)            -->
    <!-- Used in simple payment scenarios          -->
    <!-- ========================================== -->
    <tech-list>
        <tech>android.nfc.tech.MifareUltralight</tech>
    </tech-list>

</resources>

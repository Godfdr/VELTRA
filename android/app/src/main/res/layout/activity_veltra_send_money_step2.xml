<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_revert"
        android:layout_margin="20dp"
        android:contentDescription="@string/cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Recipient Info -->
    <LinearLayout
        android:id="@+id/recipientInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/quick_action_background" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="@color/white"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+234 810 123 4567"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/amountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/amount_label"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/recipientInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Amount Input Display -->
    <LinearLayout
        android:id="@+id/amountDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/amountLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₦"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/amountInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="0"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:textStyle="bold"
            android:background="@null"
            android:inputType="number"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Quick Select Chips -->
    <LinearLayout
        android:id="@+id/quickChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/amountDisplay">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₦1,000"
            android:textColor="@color/text_secondary"
            android:background="@drawable/quick_action_background"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₦2,000"
            android:textColor="@color/text_secondary"
            android:background="@drawable/quick_action_background"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₦5,000"
            android:textColor="@color/text_secondary"
            android:background="@drawable/quick_action_background"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other"
            android:textColor="@color/text_secondary"
            android:background="@drawable/quick_action_background"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="4dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/noteInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/quick_action_background"
        android:hint="@string/add_note"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/quickChips" />

    <Button
        android:id="@+id/continueBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:text="@string/continue_btn"
        android:background="@drawable/pay_button_background"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

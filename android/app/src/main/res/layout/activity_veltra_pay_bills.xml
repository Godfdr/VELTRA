<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="@string/cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pay Bills"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/billsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/backBtn">

        <!-- Airtime -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
            <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/quick_action_background" android:backgroundTint="#1500D4FF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Airtime" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Data -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
            <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/quick_action_background" android:backgroundTint="#157000FF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Electricity -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
            <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/quick_action_background" android:backgroundTint="#15FFA502" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Electricity" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- TV -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
            <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/quick_action_background" android:backgroundTint="#1500D084" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TV" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Internet -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
            <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/quick_action_background" android:backgroundTint="#15FF4757" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Internet" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Water -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
            <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/quick_action_background" android:backgroundTint="#1500A8FF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

    </GridLayout>

    <TextView
        android:id="@+id/recentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recent Payments"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/billsGrid" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/quick_action_background"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/recentLabel">

        <View android:id="@+id/recent_icon" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/quick_action_background" android:backgroundTint="#2000D084" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/recent_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MTN Airtime" android:textColor="@color/white" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintStart_toEndOf="@id/recent_icon" app:layout_constraintTop_toTopOf="@id/recent_icon" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+234 810 123 4567" android:textColor="@color/text_muted" android:textSize="10sp" app:layout_constraintStart_toStartOf="@id/recent_name" app:layout_constraintTop_toBottomOf="@id/recent_name" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₦ 1,000" android:textColor="@color/white" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

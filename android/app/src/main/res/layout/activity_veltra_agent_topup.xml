<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="@string/cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_veltra_logo"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- QR Code Section with Glass Effect -->
    <androidx.cardview.widget.CardView
        android:id="@+id/qrSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/backBtn">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:id="@+id/qrCodeImage"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/edittext_background"
                android:backgroundTint="@color/white"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_crop"
                android:contentDescription="Top Up QR Code" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_qr_to_agent"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="20dp"
                android:alpha="0.8" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Location Search -->
    <TextView
        android:id="@+id/findAgentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/find_agents"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/qrSection"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/locationInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_background"
        android:hint="@string/enter_location"
        android:textColorHint="@color/edittext_hint_themed"
        android:textColor="@color/edittext_text_themed"
        android:paddingHorizontal="20dp"
        android:drawableStart="@android:drawable/ic_menu_mylocation"
        android:drawablePadding="12dp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/findAgentLabel" />

    <!-- Agent List (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/agentsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/locationInput"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Loading State -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="40dp"
        android:indeterminateTint="@color/veltra_primary"
        app:layout_constraintTop_toBottomOf="@id/locationInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mock NFC Button (Floating Action) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/simulateNfcBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Simulate NFC Tap"
        android:textColor="@color/white"
        app:icon="@android:drawable/ic_menu_send"
        app:iconTint="@color/white"
        app:backgroundTint="@color/veltra_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="@string/cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/agent_topup"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- QR Code Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/qrSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/quick_action_background"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/backBtn">

        <ImageView
            android:id="@+id/qrCodeImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@android:drawable/ic_menu_crop"
            android:padding="20dp"
            android:background="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Top Up QR Code" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_qr_to_agent"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/qrCodeImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Location Search -->
    <TextView
        android:id="@+id/findAgentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/find_agents"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/qrSection"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/locationInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/quick_action_background"
        android:hint="@string/enter_location"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:drawableStart="@android:drawable/ic_menu_mylocation"
        android:drawablePadding="12dp"
        app:layout_constraintTop_toBottomOf="@id/findAgentLabel" />

    <!-- Agent List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/locationInput"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Mock Agent 1 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_action_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView android:id="@+id/a1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Veltra Hub - Lekki" android:textColor="@color/white" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open until 8:00 PM" android:textColor="@color/veltra_success" android:textSize="10sp" android:layout_below="@id/a1_name" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.5 km" android:textColor="@color/text_muted" android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- Mock Agent 2 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_action_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <TextView android:id="@+id/a2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mama's Corner Store" android:textColor="@color/white" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open until 10:00 PM" android:textColor="@color/veltra_success" android:textSize="10sp" android:layout_below="@id/a2_name" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.2 km" android:textColor="@color/text_muted" android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

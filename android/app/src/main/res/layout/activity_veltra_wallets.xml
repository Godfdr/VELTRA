<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallets"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_new_wallet"
            android:textColor="@color/veltra_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/organize_money"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Main Wallet -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainWalletPocket"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/wallet_card_gradient"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                <TextView android:id="@+id/w1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/main_wallet" android:textColor="@color/white" android:alpha="0.8" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₦ 25,600.50" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/w1_label" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Transport Wallet -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/transportWalletPocket"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/quick_action_background"
                android:backgroundTint="@color/veltra_primary"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                <TextView android:id="@+id/w2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/transport_wallet" android:textColor="@color/white" android:alpha="0.8" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₦ 8,400.00" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/w2_label" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Savings Pocket -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/savingsPocket"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/quick_action_background"
                android:backgroundTint="@color/veltra_secondary"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                <TextView android:id="@+id/w3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/savings_pocket" android:textColor="@color/white" android:alpha="0.8" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₦ 120,000.00" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/w3_label" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Offline Wallet Pocket -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/offlineWalletPocket"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/quick_action_background"
                android:backgroundTint="@color/veltra_warning"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                <TextView android:id="@+id/w4_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/offline_wallet_pocket" android:textColor="@color/white" android:alpha="0.8" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₦ 12,000.00" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/w4_label" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Create New Card Button -->
            <RelativeLayout
                android:id="@+id/createNewWalletBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_action_background"
                android:padding="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">
                <TextView android:id="@+id/createTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/create_new_wallet" android:textColor="@color/white" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/organize_money" android:textColor="@color/text_muted" android:textSize="12sp" android:layout_below="@id/createTitle" />
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_add" android:layout_alignParentEnd="true" android:layout_centerVertical="true" app:tint="@color/white" android:contentDescription="Add" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

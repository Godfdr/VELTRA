<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <TextView
        android:id="@+id/adminTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Terminal"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/statusIndicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@color/veltra_success"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/adminTitle"
        app:layout_constraintTop_toTopOf="@id/adminTitle"
        app:layout_constraintBottom_toBottomOf="@id/adminTitle" />

    <!-- Stats Row -->
    <LinearLayout
        android:id="@+id/statsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/adminTitle">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/quick_action_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginEnd="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Agents" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="142" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/quick_action_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Volume" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₦ 4.2M" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- System Controls -->
    <TextView
        android:id="@+id/controlsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Controls"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statsRow" />

    <LinearLayout
        android:id="@+id/controlsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/controlsLabel">

        <Button
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Freeze Offline Pockets"
            android:background="@drawable/quick_action_background"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Audit Transaction Logs"
            android:background="@drawable/quick_action_background"
            android:textColor="@color/white"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- Logs Console -->
    <TextView
        android:id="@+id/logsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real-time Node Logs"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/controlsList" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#FF000000"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/logsLabel"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[INFO] NFC Node Alpha connected...\n[SEC] HSM Initialized...\n[AUTH] User session 742 valid...\n[INFO] ₦2k top-up at Agent 14...\n[WARN] High latency on P2P mesh..."
            android:textColor="#FF00FF00"
            android:fontFamily="monospace"
            android:textSize="10sp" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

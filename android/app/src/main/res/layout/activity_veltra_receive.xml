<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="@string/cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/receive"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- QR Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/qrContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/quick_action_background"
        android:padding="32dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/backBtn">

        <ImageView
            android:id="@+id/receiveQrCode"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@color/white"
            android:padding="16dp"
            android:src="@android:drawable/ic_menu_crop"
            android:contentDescription="Your Payment QR Code"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tola Adebayo"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/receiveQrCode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/veltraId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="veltra.id/tola88"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/userName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/qrContainer">

        <Button
            android:id="@+id/copyIdBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Copy ID"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"
            android:background="@drawable/quick_action_background" />

        <Button
            android:id="@+id/shareQrBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Share QR"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:layout_marginStart="8dp"
            android:background="@drawable/pay_button_background" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan this QR code to receive money instantly\nfrom another Veltra user."
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:textSize="12sp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

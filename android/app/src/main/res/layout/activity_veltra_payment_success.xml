<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="24dp">

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="@string/nav_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/successBadge"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/checkbox_on_background"
        app:tint="@color/veltra_success"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"
        android:contentDescription="Success" />

    <TextView
        android:id="@+id/successTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/payment_successful"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/successBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/successAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₦ 5,000.00"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/successTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/successSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sent to John Doe\n+234 810 123 4567"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/successAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Details Card -->
    <LinearLayout
        android:id="@+id/detailsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/quick_action_background"
        android:padding="16dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/successSub">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/date_time_label" android:textColor="@color/text_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="May 25, 2024 - 9:41 AM" android:textColor="@color/white" android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reference_label" android:textColor="@color/text_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VT245669874" android:textColor="@color/white" android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/payment_method_label" android:textColor="@color/text_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Veltra Wallet" android:textColor="@color/white" android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/new_balance_label" android:textColor="@color/text_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₦ 20,600.50" android:textColor="@color/white" android:layout_alignParentEnd="true" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/shareBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/share_receipt"
            android:background="@drawable/quick_action_background"
            android:layout_marginEnd="8dp"
            android:textColor="@color/white"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/doneBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/done"
            android:background="@drawable/pay_button_background"
            android:backgroundTint="@color/veltra_success"
            android:textColor="@color/white"
            android:textAllCaps="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Main Right Arm of the V (Purple) -->
    <path
        android:pathData="M512,824 L824,200 L650,200 L512,500 L512,824 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="512"
                android:startY="200"
                android:endX="824"
                android:endY="824"
                android:type="linear">
                <item android:color="#7000FF" android:offset="0.0" />
                <item android:color="#00D4FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Left Arm of the V (Cyan/Blue) -->
    <path
        android:pathData="M200,200 L512,824 L512,500 L374,200 L200,200 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="200"
                android:startY="200"
                android:endX="512"
                android:endY="824"
                android:type="linear">
                <item android:color="#00D4FF" android:offset="0.0" />
                <item android:color="#00A8FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center fold/shadow -->
    <path
        android:fillColor="#20000000"
        android:pathData="M512,500 L512,824 L374,200 L512,500 Z" />

</vector>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Shadow/Background flap of the V -->
    <path
        android:pathData="M110,165 L155,60 C157,55 155,50 150,50 L125,50 L95,120 L110,165 Z"
        android:fillColor="#1A000000" />

    <!-- Left Flap (Cyan to Blue Gradient) -->
    <path
        android:pathData="M55,50 C50,50 48,55 50,60 L95,160 C97,165 103,165 105,160 L120,120 L85,50 L55,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="50"
                android:endX="100"
                android:endY="160"
                android:type="linear">
                <item android:offset="0" android:color="#00E5FF" />
                <item android:offset="1" android:color="#007BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Flap (Purple Gradient - Overlapping) -->
    <path
        android:pathData="M150,50 C155,50 157,55 155,60 L110,165 C108,170 102,170 100,165 L85,125 L120,50 L150,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="155"
                android:startY="50"
                android:endX="100"
                android:endY="170"
                android:type="linear">
                <item android:offset="0" android:color="#7000FF" />
                <item android:offset="1" android:color="#4B0082" />
            </gradient>
        </aapt:attr>
    </path>

</vector>

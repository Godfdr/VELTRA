<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VELTRA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/veltra_primary</item>
        <item name="colorPrimaryVariant">@color/veltra_secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/veltra_secondary</item>
        <item name="colorSecondaryVariant">@color/veltra_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Background color. -->
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default policy for all domains -->
    <domain-config cleartextTrafficAllowed="false">
        <!-- VELTA API Domains with certificate pinning -->
        <domain includeSubdomains="true">api.velta.io</domain>
        <domain includeSubdomains="true">staging-api.velta.io</domain>
        <domain includeSubdomains="true">payments.velta.io</domain>

        <!-- Payment Gateway Domains -->
        <domain includeSubdomains="true">stripe.com</domain>
        <domain includeSubdomains="true">square.com</domain>
        <domain includeSubdomains="true">paypal.com</domain>
        <domain includeSubdomains="true">google.com</domain>

        <!-- Trust system certificates -->
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!-- Allow cleartext for localhost testing only -->
    <domain-config cleartextTrafficAllowed="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!-- 
    VELTA Android - Network Security Configuration
    Location: res/xml/network_security_config.xml
    
    This file ensures secure HTTPS connections to payment backend servers
    with certificate pinning for fraud prevention.
-->
<network-security-config>

    <!-- ========================================== -->
    <!-- VELTA API SERVER CONFIGURATION            -->
    <!-- ========================================== -->
    <domain-config cleartextTrafficPermitted="false">
        
        <!-- Production API Server -->
        <domain includeSubdomains="true">api.velta.io</domain>
        
        <!-- Staging API Server -->
        <domain includeSubdomains="true">staging-api.velta.io</domain>
        
        <!-- Payment Processing Server -->
        <domain includeSubdomains="true">payments.velta.io</domain>
        
        <!-- Certificate Pinning - Production -->
        <pin-set expiration="2025-12-31">
            <!-- Pin the SHA-256 hashes of your certificates -->
            <!-- Generate with: openssl s_client -connect api.velta.io:443 | openssl x509 -pubkey -noout | openssl pkey -pubin -outform DER | openssl dgst -sha256 -binary | base64 -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>

        <!-- Certificate Authority Trust -->
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!-- ========================================== -->
    <!-- THIRD-PARTY SERVICE CONFIGURATION         -->
    <!-- ========================================== -->
    <domain-config cleartextTrafficPermitted="false">
        
        <!-- Stripe Payment Processing -->
        <domain includeSubdomains="true">api.stripe.com</domain>
        <domain includeSubdomains="true">api-uat.stripe.com</domain>
        
        <!-- Square Payment Processing -->
        <domain includeSubdomains="true">api.squareup.com</domain>
        
        <!-- PayPal Integration -->
        <domain includeSubdomains="true">api.paypal.com</domain>
        
        <!-- Google Pay -->
        <domain includeSubdomains="true">pay.google.com</domain>
        
        <!-- System certificate authorities -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- ========================================== -->
    <!-- LOCAL TESTING CONFIGURATION (Debug Only)  -->
    <!-- Remove for production!                    -->
    <!-- ========================================== -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
